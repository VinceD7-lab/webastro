---
/**
 * Équation du temps : écart entre le temps solaire vrai (cadran solaire) et le temps solaire moyen (horloge).
 * On voit les deux effets qui la produisent (excentricité de l’orbite, obliquité de l’écliptique), que l’on peut supprimer,
 * et l’analemme : position du Soleil à midi moyen au cours de l’année.
 */
---
<div class="sim" data-equation-temps data-pagefind-ignore>
  <svg viewBox="0 0 600 330" role="img" aria-label="Équation du temps au cours de l’année et analemme du Soleil">
    <g data-fond font-family="Literata Variable, Georgia, serif"></g>
    <g data-dyn font-family="Literata Variable, Georgia, serif"></g>
  </svg>
  <div class="controls">
    <label><span>Date</span> <input data-jour type="range" min="1" max="365" step="1" value="307" /> <output data-jour-out></output></label>
    <fieldset>
      <legend>Effets pris en compte</legend>
      <label><input data-exc type="checkbox" checked /> excentricité de l’orbite</label>
      <label><input data-obl type="checkbox" checked /> obliquité de l’écliptique</label>
    </fieldset>
  </div>
  <div class="readout" aria-live="polite">
    <div><b data-eot>–</b><span>équation du temps</span></div>
    <div><b data-midi>–</b><span>midi vrai, en temps solaire moyen</span></div>
    <div><b data-dec>–</b><span>déclinaison du Soleil</span></div>
  </div>
  <p class="note">À gauche : l’équation du temps (en noir), avec l’effet de l’excentricité (en tirets dorés) et celui de l’obliquité (en tirets bleus). À droite : l’analemme, c’est-à-dire la position du Soleil à midi moyen (heure solaire moyenne) tout au long de l’année : en abscisse l’équation du temps, en ordonnée la déclinaison. Les calculs sont faits pour une année ordinaire ; les valeurs varient de quelques secondes d’une année à l’autre.</p>
</div>

<style>
  .sim{border:1px solid var(--rule);border-radius:10px;background:var(--bg);padding:1rem;margin:1.8rem 0}
  svg{display:block;width:100%;height:auto}
  .controls{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem 1.2rem;margin-top:.8rem;font-size:.95rem}
  .controls > label{display:flex;align-items:center;gap:.5rem;flex:1 1 280px;flex-wrap:wrap}
  .controls output{min-width:7em;font-variant-numeric:tabular-nums}
  fieldset{border:0;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:.3rem 1.4rem}
  legend{padding:0;color:var(--ink-soft);font-size:.9rem;margin-bottom:.2rem}
  fieldset label{display:flex;align-items:center;gap:.4rem}
  input[type=checkbox]{accent-color:var(--brass)}
  input[type=range]{flex:1;min-width:120px;accent-color:var(--brass)}
  .readout{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;margin-top:.9rem;font-size:.9rem}
  .readout div{border-top:1px solid var(--rule);padding-top:.4rem}
  .readout b{display:block;font-family:var(--display);font-size:1.3rem;font-weight:600;font-variant-numeric:tabular-nums}
  .readout span{color:var(--ink-soft)}
  .note{font-size:.85rem;color:var(--ink-soft);margin:.6rem 0 0}
</style>

<script>
  import { equationDuTemps, jdDuJour } from '../lib/temps';
  import { chemin, texte2D, trait2D, type P2 } from '../lib/projection';
  import { nbFr as nb } from '../lib/relativite';

  const ANNEE = 2023, M = 20; // M : minutes en haut et en bas de la courbe
  const G0: P2 = [48, 290], GW = 330, GH = 240;
  const gx = (j: number) => G0[0] + ((j - 1) / 364) * GW, gy = (m: number) => G0[1] - ((m + M) / (2 * M)) * GH;
  // Analemme : x = équation du temps (min), y = déclinaison (°).
  const A0: P2 = [490, 160], AX = 5.2, AY = 5.2;
  const ax = (m: number) => A0[0] + m * AX, ay = (d: number) => A0[1] - d * AY;
  const dateTxt = (j: number) => new Date(Date.UTC(ANNEE, 0, j)).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', timeZone: 'UTC' });
  const minSec = (m: number) => { const a = Math.abs(m), mi = Math.floor(a), se = Math.round((a - mi) * 60); return `${m < 0 ? '−' : '+'}${mi} min ${String(se).padStart(2, '0')} s`; };

  document.querySelectorAll<HTMLElement>('[data-equation-temps]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const jour = q<HTMLInputElement>('[data-jour]'), exc = q<HTMLInputElement>('[data-exc]'), obl = q<HTMLInputElement>('[data-obl]');
    const jours = Array.from({ length: 365 }, (_, i) => i + 1);

    function maj() {
      const opt = { excentricite: exc.checked, obliquite: obl.checked }, j = +jour.value;
      const val = (d: number) => equationDuTemps(jdDuJour(ANNEE, d), opt);
      let s = '';
      for (let m = -20; m <= 20; m += 10) s += `<line x1="${G0[0]}" x2="${G0[0] + GW}" y1="${gy(m)}" y2="${gy(m)}" stroke="${m === 0 ? 'var(--ink-soft)' : 'var(--rule)'}" stroke-width="${m === 0 ? 1.3 : 0.9}"/>` + texte2D([G0[0] - 7, gy(m) + 4], String(m).replace('-', '−'), { ancre: 'end', taille: 11.5, couleur: 'var(--ink-soft)' });
      const deb = [1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335], mois = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
      deb.forEach((d, i) => { s += texte2D([gx(d + 15), G0[1] + 17], mois[i], { ancre: 'middle', taille: 12, couleur: 'var(--ink-soft)' }); });
      s += texte2D([G0[0] - 7, G0[1] - GH - 12], 'minutes', { taille: 12, couleur: 'var(--ink-soft)' });
      const courbe = (f: (e: ReturnType<typeof equationDuTemps>) => number): P2[] => jours.map((d) => [gx(d), gy(f(val(d)))]);
      if (exc.checked) s += `<path d="${chemin(courbe((e) => e.centre))}" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-dasharray="6 4"/>`;
      if (obl.checked) s += `<path d="${chemin(courbe((e) => e.reduction))}" fill="none" stroke="var(--orbit)" stroke-width="1.5" stroke-dasharray="6 4"/>`;
      s += `<path d="${chemin(courbe((e) => e.total))}" fill="none" stroke="var(--ink)" stroke-width="2.6"/>`;
      const e = val(j);
      s += `<line x1="${gx(j)}" x2="${gx(j)}" y1="${G0[1]}" y2="${gy(e.total)}" stroke="var(--ko)" stroke-width="1" stroke-dasharray="3 3"/><circle cx="${gx(j).toFixed(1)}" cy="${gy(e.total).toFixed(1)}" r="5.5" fill="var(--ko)" stroke="var(--surface)" stroke-width="2"/>`;
      // Analemme.
      s += trait2D([A0[0] - 90, A0[1]], [A0[0] + 90, A0[1]], { couleur: 'var(--rule)', epaisseur: 1 }) + trait2D([A0[0], A0[1] + 130], [A0[0], A0[1] - 130], { couleur: 'var(--rule)', epaisseur: 1 });
      s += texte2D([A0[0] + 92, A0[1] + 4], '+', { taille: 13, couleur: 'var(--ink-soft)' }) + texte2D([A0[0] - 92, A0[1] + 4], '−', { ancre: 'end', taille: 13, couleur: 'var(--ink-soft)' });
      s += texte2D([A0[0] + 6, A0[1] - 124], '+23,4°', { taille: 11.5, couleur: 'var(--ink-soft)' }) + texte2D([A0[0] + 6, A0[1] + 146], '−23,4°', { taille: 11.5, couleur: 'var(--ink-soft)' });
      s += texte2D([A0[0], 14], 'analemme', { ancre: 'middle', taille: 13, gras: true });
      s += texte2D([A0[0] + 92, A0[1] + 20], 'équation du temps', { ancre: 'end', taille: 11, couleur: 'var(--ink-soft)' });
      const an: P2[] = jours.map((d) => { const v = val(d); return [ax(v.total), ay(v.declinaison)]; });
      s += `<path d="${chemin(an)}" fill="none" stroke="var(--ink)" stroke-width="2"/>`;
      const p: P2 = [ax(e.total), ay(e.declinaison)];
      s += `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="6" fill="var(--sun)" stroke="var(--ink)" stroke-width="1.4"/>`;
      q('[data-fond]').innerHTML = '';
      q('[data-dyn]').innerHTML = s;
      q('[data-jour-out]').textContent = dateTxt(j);
      q('[data-eot]').textContent = minSec(e.total);
      const sec = Math.round((720 - e.total) * 60); // midi vrai : le temps moyen vaut 12 h − équation du temps
      q('[data-midi]').textContent = `${Math.floor(sec / 3600)} h ${String(Math.floor((sec % 3600) / 60)).padStart(2, '0')} min ${String(sec % 60).padStart(2, '0')} s`;
      q('[data-dec]').textContent = `${e.declinaison < 0 ? '−' : '+'}${nb(Math.abs(e.declinaison), 1)}°`;
    }
    for (const el of [jour, exc, obl]) el.addEventListener('input', maj);
    maj();
  });
</script>
