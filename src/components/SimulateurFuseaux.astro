---
/**
 * Fuseaux horaires et ligne de changement de date : planisphère schématique (sans continents), 24 fuseaux de 15°.
 * On fait varier l’heure en temps universel (UTC) ; les heures légales s’en déduisent par un décalage entier d’heures
 * (sauf l’Inde, +5 h 30). Jour et nuit sont dessinés pour un équinoxe, à l’équation du temps près.
 */
---
<div class="sim" data-fuseaux data-pagefind-ignore>
  <svg viewBox="0 0 600 300" role="img" aria-label="Planisphère schématique divisé en 24 fuseaux horaires, avec la ligne de changement de date, la zone de nuit et l’heure légale de quelques villes">
    <g data-fond font-family="Literata Variable, Georgia, serif"></g>
    <g data-dyn font-family="Literata Variable, Georgia, serif"></g>
  </svg>
  <div class="controls">
    <label><span>Heure UTC</span> <input data-utc type="range" min="0" max="1439" step="5" value="660" /> <output data-utc-out></output></label>
    <label><span>Ville</span>
      <select data-ville aria-label="Ville dont on lit l’heure légale">
        <option value="2.35,1">Paris</option><option value="-0.13,0">Londres</option><option value="-74,-5">New York</option>
        <option value="-157.9,-10">Honolulu</option><option value="77.2,5.5">New Delhi</option><option value="139.7,9">Tokyo</option>
        <option value="174.8,12">Auckland</option>
      </select>
    </label>
  </div>
  <div class="readout" aria-live="polite">
    <div><b data-utc-r>–</b><span>temps universel (UTC)</span></div>
    <div><b data-loc>–</b><span>heure légale de la ville</span></div>
    <div><b data-date>–</b><span>date dans cette ville, par rapport à la date UTC</span></div>
  </div>
  <p class="note">Les rangées du bas donnent l’heure légale de chaque fuseau ; la couleur indique la date, relative à celle du temps universel. De part et d’autre de la ligne de changement de date (à 180° de longitude), l’heure est presque la même, mais la date diffère d’un jour. Positions des villes en heure d’hiver ; en été, beaucoup de pays ajoutent une heure.</p>
</div>

<style>
  .sim{border:1px solid var(--rule);border-radius:10px;background:var(--bg);padding:1rem;margin:1.8rem 0}
  svg{display:block;width:100%;height:auto}
  .controls{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem 1.2rem;margin-top:.8rem;font-size:.95rem}
  .controls label{display:flex;align-items:center;gap:.5rem;flex:1 1 260px;flex-wrap:wrap}
  .controls output{min-width:5em;font-variant-numeric:tabular-nums}
  input[type=range]{flex:1;min-width:120px;accent-color:var(--brass)}
  .readout{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;margin-top:.9rem;font-size:.9rem}
  .readout div{border-top:1px solid var(--rule);padding-top:.4rem}
  .readout b{display:block;font-family:var(--display);font-size:1.3rem;font-weight:600;font-variant-numeric:tabular-nums}
  .readout span{color:var(--ink-soft)}
  .note{font-size:.85rem;color:var(--ink-soft);margin:.6rem 0 0}
</style>

<script>
  import { texte2D, type P2 } from '../lib/projection';

  const X0 = 40, W = 520, Y0 = 48, H = 150;
  /** Abscisse de l’étiquette du fuseau k : les deux demi-fuseaux ±12 sont étiquetés dans les marges. */
  const cxk = (k: number) => (k === -12 ? x(-180) - 17 : k === 12 ? x(180) + 17 : x(15 * k));
  const x = (lon: number) => X0 + ((lon + 180) / 360) * W;
  const pad = (n: number) => String(n).padStart(2, '0');
  const hhmm = (m: number) => `${pad(Math.floor(((m % 1440) + 1440) % 1440 / 60))} h ${pad(Math.floor(((m % 60) + 60) % 60))}`;
  const jourRel = (m: number) => (m < 0 ? -1 : m >= 1440 ? 1 : 0);
  const COUL: Record<number, string> = { [-1]: 'var(--orbit)', 0: 'var(--ink-soft)', 1: 'var(--brass)' };
  const NOM: Record<number, string> = { [-1]: 'la veille', 0: 'même jour', 1: 'lendemain' };
  const decal = (h: number) => (h > 0 ? '+' : '−') + Math.abs(h);

  document.querySelectorAll<HTMLElement>('[data-fuseaux]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const utc = q<HTMLInputElement>('[data-utc]'), ville = q<HTMLSelectElement>('[data-ville]');

    let f = '';
    for (let k = -12; k <= 12; k++) {
      const a = Math.max(-180, 15 * k - 7.5), b = Math.min(180, 15 * k + 7.5);
      f += `<rect x="${x(a).toFixed(1)}" y="${Y0}" width="${(x(b) - x(a)).toFixed(1)}" height="${H}" fill="var(--${k % 2 ? 'surface-2' : 'surface'})" stroke="var(--rule)" stroke-width=".8"/>`;
      f += texte2D([cxk(k), Y0 - 8], k === 0 ? 'UTC' : decal(k), { ancre: 'middle', taille: 11, couleur: 'var(--ink-soft)' });
    }
    f += `<line x1="${x(-180)}" x2="${x(-180)}" y1="${Y0 - 4}" y2="${Y0 + H + 4}" stroke="var(--ko)" stroke-width="2" stroke-dasharray="6 4"/><line x1="${x(180)}" x2="${x(180)}" y1="${Y0 - 4}" y2="${Y0 + H + 4}" stroke="var(--ko)" stroke-width="2" stroke-dasharray="6 4"/>`;
    f += texte2D([x(-180) + 4, Y0 + H + 18], 'ligne de changement de date', { taille: 11.5, couleur: 'var(--ko)' }) + texte2D([x(180) - 4, Y0 + H + 18], 'ligne de changement de date', { ancre: 'end', taille: 11.5, couleur: 'var(--ko)' });
    f += `<line x1="${x(0)}" x2="${x(0)}" y1="${Y0}" y2="${Y0 + H}" stroke="var(--ink-soft)" stroke-width="1.4"/>`;
    q('[data-fond]').innerHTML = f;

    function maj() {
      const m = +utc.value; // minutes UTC, de 0 à 1439
      // Longitude du point subsolaire : midi UTC au méridien de Greenwich.
      const lonSol = -((m - 720) / 4);
      let s = '';
      // Nuit : à plus de 90° du point subsolaire (équinoxe), bandes éventuellement coupées par le bord de la carte.
      for (const dec of [-360, 0, 360]) {
        const a = lonSol + dec + 90, b = lonSol + dec + 270, l0 = Math.max(-180, a), l1 = Math.min(180, b);
        if (l1 > l0) s += `<rect x="${x(l0).toFixed(1)}" y="${Y0}" width="${(x(l1) - x(l0)).toFixed(1)}" height="${H}" fill="var(--ink)" fill-opacity=".28"/>`;
      }
      const ps: P2 = [x(((lonSol + 540) % 360) - 180), Y0 + H / 2];
      s += `<circle cx="${ps[0].toFixed(1)}" cy="${ps[1]}" r="9" fill="var(--sun)" stroke="var(--ink)" stroke-width="1"/>`;
      // Heures légales, deux rangées sous la carte.
      for (let k = -12; k <= 12; k++) {
        const loc = m + 60 * k, r = jourRel(loc), cx = cxk(k);
        s += texte2D([cx, Y0 + H + 40], String(Math.floor(((loc % 1440) + 1440) % 1440 / 60)), { ancre: 'middle', taille: 12.5, gras: true, couleur: COUL[r] });
        s += `<rect x="${(cx - 9).toFixed(1)}" y="${Y0 + H + 48}" width="18" height="5" rx="2" fill="${COUL[r]}"/>`;
      }
      s += texte2D([X0, Y0 + H + 68], 'heure légale par fuseau :', { taille: 11.5, couleur: 'var(--ink-soft)' });
      let lx = X0 + 150;
      for (const r of [-1, 0, 1]) { s += `<rect x="${lx}" y="${Y0 + H + 60}" width="14" height="6" rx="2" fill="${COUL[r]}"/>` + texte2D([lx + 20, Y0 + H + 68], NOM[r], { taille: 11.5, couleur: COUL[r] }); lx += 110; }
      // Ville choisie.
      const [lon, dec] = ville.value.split(',').map(Number), loc = m + 60 * dec, r = jourRel(loc);
      const px = x(lon);
      s += `<circle cx="${px.toFixed(1)}" cy="${Y0 + 52}" r="6" fill="var(--ko)" stroke="var(--surface)" stroke-width="2"/>` + texte2D([px, Y0 + 40], ville.selectedOptions[0].textContent!, { ancre: 'middle', taille: 12.5, gras: true, couleur: 'var(--ko)' });
      q('[data-dyn]').innerHTML = s;
      q('[data-utc-out]').textContent = hhmm(m);
      q('[data-utc-r]').textContent = hhmm(m);
      q('[data-loc]').textContent = hhmm(loc);
      q('[data-date]').textContent = r === 0 ? 'même jour' : r < 0 ? 'la veille' : 'le lendemain';
    }
    for (const el of [utc, ville]) el.addEventListener('input', maj);
    maj();
  });
</script>
