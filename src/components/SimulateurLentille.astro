---
/**
 * Lentille gravitationnelle ponctuelle : on déplace une galaxie lointaine derrière une masse ; on voit ses images
 * déformées (deux arcs) et, quand l’alignement est parfait, un anneau d’Einstein.
 * Chaque point de la source donne deux images, calculées par l’équation de lentille (lib/relativite.ts).
 */
---
<div class="sim" data-lentille data-pagefind-ignore>
  <svg viewBox="0 0 600 400" role="application" tabindex="0" aria-label="Ciel vu à travers une lentille gravitationnelle. Faites glisser la source, ou utilisez les flèches du clavier pour la déplacer.">
    <g data-fond font-family="Literata Variable, Georgia, serif"></g>
    <path data-images fill="var(--orbit)" fill-opacity=".85" fill-rule="evenodd" stroke="var(--orbit)" stroke-width="1"></path>
    <g data-dyn font-family="Literata Variable, Georgia, serif"></g>
  </svg>
  <div class="controls">
    <label><span>Taille de la source</span> <input data-taille type="range" min="0.04" max="0.6" step="0.01" value="0.18" /> <output data-taille-out></output></label>
    <div class="presets" role="group" aria-label="Positions de la source">
      <button class="tool" type="button" data-pos="0,0">Alignement parfait</button>
      <button class="tool" type="button" data-pos="0.35,0.12">Presque aligné</button>
      <button class="tool" type="button" data-pos="1.6,-0.7">Loin de l’axe</button>
    </div>
  </div>
  <div class="readout" aria-live="polite">
    <div><b data-u>–</b><span>écart à l’axe, en rayons d’Einstein</span></div>
    <div><b data-nb>–</b><span>ce que l’on voit</span></div>
    <div><b data-ampli>–</b><span>amplification de l’éclat</span></div>
  </div>
  <p class="note">Faites glisser la source (cercle en tirets : sa vraie position, invisible pour l’observateur) ou utilisez les flèches du clavier. Les images bleues sont ce que l’on voit réellement. Le rayon d’Einstein dépend de la masse de la lentille et des distances : de l’ordre d’une seconde d’arc pour une galaxie, quelques dizaines de secondes d’arc pour un amas massif comme Abell 2218.</p>
</div>

<style>
  svg{display:block;width:100%;height:auto;touch-action:none;cursor:grab;border-radius:6px}
  svg.tient{cursor:grabbing}
  .controls label{display:flex;align-items:center;gap:.5rem;flex:1 1 260px;flex-wrap:wrap}
  .controls output{min-width:5em;font-variant-numeric:tabular-nums}
  .presets{display:flex;flex-wrap:wrap;gap:.4rem}
  input[type=range]{flex:1;min-width:120px;accent-color:var(--brass)}
  .readout{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;margin-top:.9rem;font-size:.9rem}
  .readout b{display:block;font-family:var(--display);font-size:1.35rem;font-weight:600;font-variant-numeric:tabular-nums}
  .note{font-size:.85rem;color:var(--ink-soft);margin:.6rem 0 0}
</style>

<script>
  import { imagesLentille, amplification, nbFr } from '../lib/relativite';
  import { chemin, texte2D, type P2 } from '../lib/projection';

  const nb = (x: number, d = 2) => nbFr(x, d);
  const O: P2 = [300, 200], TE = 95, XMAX = 2.9, YMAX = 1.95; // TE : rayon d’Einstein en pixels
  const ecran = (x: number, y: number): P2 => [O[0] + x * TE, O[1] - y * TE];

  document.querySelectorAll<HTMLElement>('[data-lentille]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const svg = q<SVGSVGElement>('svg'), taille = q<HTMLInputElement>('[data-taille]'), images = q('[data-images]');
    let sx = 0.35, sy = 0.12, tient = false;

    let f = '';
    // Quelques étoiles de fond, fixes (générateur pseudo-aléatoire à graine).
    let g = 7;
    const alea = () => ((g = (g * 16807) % 2147483647) / 2147483647);
    for (let i = 0; i < 60; i++) f += `<circle cx="${(alea() * 600).toFixed(1)}" cy="${(alea() * 400).toFixed(1)}" r="${(0.5 + alea()).toFixed(1)}" fill="var(--ink-soft)" opacity=".35"/>`;
    f += `<circle cx="${O[0]}" cy="${O[1]}" r="${TE}" fill="none" stroke="var(--brass)" stroke-width="1.1" stroke-dasharray="5 5"/>`;
    f += texte2D([O[0] - TE * 0.71, O[1] + TE * 0.71], 'rayon d’Einstein', { dx: -6, dy: 16, ancre: 'end', taille: 12, couleur: 'var(--brass)' });
    f += `<circle cx="${O[0]}" cy="${O[1]}" r="9" fill="var(--brass)" stroke="var(--ink)" stroke-width="1"/>`;
    f += texte2D(O, 'lentille', { dx: 0, dy: 26, ancre: 'middle', taille: 12.5, couleur: 'var(--brass)' });
    q('[data-fond]').innerHTML = f;

    function maj() {
      const r = parseFloat(taille.value), N = 220;
      const plus: P2[] = [], moins: P2[] = [];
      for (let i = 0; i < N; i++) {
        const a = (2 * Math.PI * i) / N, [p, m] = imagesLentille(sx + r * Math.cos(a), sy + r * Math.sin(a));
        plus.push(ecran(...p)); moins.push(ecran(...m));
      }
      images.setAttribute('d', `${chemin(plus, true)} ${chemin(moins, true)}`);
      const S = ecran(sx, sy);
      q('[data-dyn]').innerHTML = `<circle cx="${S[0].toFixed(1)}" cy="${S[1].toFixed(1)}" r="${(r * TE).toFixed(1)}" fill="var(--sun)" fill-opacity=".12" stroke="var(--sun)" stroke-width="1.5" stroke-dasharray="4 3"/>`
        + texte2D(S, 'source', { dy: -r * TE - 7, ancre: 'middle', taille: 12, couleur: 'var(--sun)' });
      const u = Math.hypot(sx, sy), anneau = u < r;
      q('[data-taille-out]').innerHTML = `${nb(r)} θ<sub>E</sub>`;
      q('[data-u]').textContent = nb(u);
      q('[data-nb]').textContent = anneau ? 'un anneau d’Einstein' : u < r * 2.5 ? 'deux arcs' : 'deux images';
      q('[data-ampli]').textContent = u < 0.02 ? 'très grande' : `× ${nb(amplification(u), 1)}`;
    }
    function placer(ev: PointerEvent) {
      const m = svg.getScreenCTM(); if (!m) return;
      const p = new DOMPoint(ev.clientX, ev.clientY).matrixTransform(m.inverse());
      sx = Math.max(-XMAX, Math.min(XMAX, (p.x - O[0]) / TE)); sy = Math.max(-YMAX, Math.min(YMAX, (O[1] - p.y) / TE));
      maj();
    }
    svg.addEventListener('pointerdown', (ev) => { tient = true; svg.classList.add('tient'); svg.setPointerCapture(ev.pointerId); placer(ev); });
    svg.addEventListener('pointermove', (ev) => { if (tient) placer(ev); });
    const lacher = () => { tient = false; svg.classList.remove('tient'); };
    svg.addEventListener('pointerup', lacher); svg.addEventListener('pointercancel', lacher);
    svg.addEventListener('keydown', (ev) => {
      const pas = ev.shiftKey ? 0.2 : 0.04, d: Record<string, [number, number]> = { ArrowLeft: [-pas, 0], ArrowRight: [pas, 0], ArrowUp: [0, pas], ArrowDown: [0, -pas] };
      const k = d[ev.key]; if (!k) return;
      ev.preventDefault();
      sx = Math.max(-XMAX, Math.min(XMAX, sx + k[0])); sy = Math.max(-YMAX, Math.min(YMAX, sy + k[1])); maj();
    });
    taille.addEventListener('input', maj);
    root.querySelectorAll<HTMLButtonElement>('[data-pos]').forEach((b) => b.addEventListener('click', () => { [sx, sy] = b.dataset.pos!.split(',').map(Number); maj(); }));
    maj();
  });
</script>
