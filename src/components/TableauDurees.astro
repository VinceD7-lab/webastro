---
/** Durée moyenne de chaque calendrier comparée au cycle astronomique visé. */
const LUNAISON = 29.530589, TROPIQUE = 365.24219;
const lignes: [string, string, number, number, 'an' | 'mois'][] = [
  ['Julien', 'solaire', 365.25, TROPIQUE, 'an'],
  ['Grégorien', 'solaire', 365.2425, TROPIQUE, 'an'],
  ['Copte', 'solaire', 365.25, TROPIQUE, 'an'],
  ['Israélite (année)', 'luni-solaire', 365.2468, TROPIQUE, 'an'],
  ['Israélite (mois)', 'luni-solaire', 29.530594, LUNAISON, 'mois'],
  ['Musulman (mois)', 'lunaire', 29.530556, LUNAISON, 'mois'],
];
const fmt = (x: number, d: number) => x.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });
const arrondi = (x: number) => { const p = 10 ** Math.max(0, Math.floor(Math.log10(x)) - 1); return (Math.round(x / p) * p).toLocaleString('fr-FR'); };
---
<div class="table-wrap">
  <table>
    <thead><tr><th scope="col">Calendrier</th><th scope="col">Type</th><th scope="col">Durée moyenne (j)</th><th scope="col">Cycle visé (j)</th><th scope="col">1 jour d’écart en</th></tr></thead>
    <tbody>
      {lignes.map(([nom, type, moy, cible, unite]) => {
        const n = 1 / Math.abs(moy - cible);
        const ans = unite === 'an' ? n : (n * LUNAISON) / TROPIQUE;
        return <tr><td>{nom}</td><td>{type}</td><td>{fmt(moy, moy > 100 ? 4 : 6)}</td><td>{fmt(cible, cible > 100 ? 5 : 6)}</td><td class="ratio">≈ {arrondi(ans)} ans</td></tr>;
      })}
    </tbody>
  </table>
</div>
