---
/**
 * Satellite gardien dans une division d’un anneau, en trois temps (redessiné d’après ASM).
 * Vue de dessus d’une portion d’anneau, dans le repère qui tourne avec le satellite :
 * les particules intérieures, plus rapides, le dépassent de gauche à droite.
 */
import Figure from '../reperes/Figure.astro';
import { chemin, texte2D, trait2D, point2D, pointe, type P2 } from '../../lib/projection';
const H = 150, W = 600;
const legendes = ['1. Une particule quitte l’anneau et entre dans la division', '2. Le satellite dévie la particule : son orbite devient excentrique', '3. Revenue dans l’anneau, elle subit des collisions qui circularisent son orbite'];
let s = '';
const grains = (y0: number, y1: number, top: number, graine: number) => {
  let g = '', x = graine;
  for (let i = 0; i < 70; i++) { x = (x * 9301 + 49297) % 233280; const px = 10 + (x / 233280) * (W - 20); x = (x * 9301 + 49297) % 233280; const py = top + y0 + (x / 233280) * (y1 - y0); g += `<circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="1.6" fill="var(--brass)" opacity=".7"/>`; }
  return g;
};
for (let k = 0; k < 3; k++) {
  const t = k * H, yS = t + 72;
  s += `<rect x="0" y="${t + 26}" width="${W}" height="24" fill="var(--brass)" fill-opacity=".22"/>` + grains(0, 24, t + 26, 7 + k);
  s += `<rect x="0" y="${t + 96}" width="${W}" height="30" fill="var(--brass)" fill-opacity=".22"/>` + grains(0, 30, t + 96, 31 + k);
  s += texte2D([W - 8, t + 42], 'anneau extérieur', { ancre: 'end', taille: 11.5, couleur: 'var(--ink-soft)' });
  s += texte2D([W - 8, t + 117], 'anneau intérieur', { ancre: 'end', taille: 11.5, couleur: 'var(--ink-soft)' });
  s += point2D([330, yS], 7, 'var(--ink)') + texte2D([330, yS], 'satellite', { dx: 12, dy: -6, taille: 12 });
  s += texte2D([8, t + 16], legendes[k], { taille: 13.5 });
  let pts: P2[] = [];
  if (k === 0) { for (let x = 40; x <= 250; x += 5) pts.push([x, t + 110 - 26 * Math.min(1, (x - 40) / 160) ** 1.5]); }
  if (k === 1) { for (let x = 200; x <= 560; x += 5) { const u = (x - 200) / 360; pts.push([x, t + 84 + 26 * Math.sin(Math.PI * u * 1.1) ** 2 * Math.min(1, u * 2.2) + (u > 0.5 ? 14 * (u - 0.5) : 0)]); } }
  if (k === 2) { for (let x = 120; x <= 460; x += 5) pts.push([x, t + 112 + 3 * Math.sin(x / 9) * Math.exp(-(x - 120) / 120)]); s += [160, 205, 250].map((x) => `<circle cx="${x}" cy="${t + 112}" r="7" fill="none" stroke="var(--ko)" stroke-width="1" stroke-dasharray="2 2"/>`).join(''); }
  s += `<path d="${chemin(pts)}" fill="none" stroke="var(--orbit)" stroke-width="2.4"/>` + pointe(pts[pts.length - 2], pts[pts.length - 1], 'var(--orbit)', 12);
  if (k < 2) s += trait2D([0, t + H - 2], [W, t + H - 2], { couleur: 'var(--rule)', epaisseur: 1 });
}
---
<Figure titre="Un satellite gardien dans une division : il dévie les particules qui y entrent, et les collisions dans l’anneau font le reste" largeur={600} hauteur={450} svg={s}><slot /></Figure>
