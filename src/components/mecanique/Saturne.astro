---
/** Saturne et ses anneaux, stylisés (d’après une image NASA / C. J. Hamilton). */
import Figure from '../reperes/Figure.astro';
import { texte2D, trait2D, type P2 } from '../../lib/projection';
const C: P2 = [300, 190], R = 78, aplati = 0.3, incl = -16;
const id = 'sat-' + Math.random().toString(36).slice(2, 8);
const ell = (k: number, sens = 0) => { const rx = k * R, ry = k * R * aplati; return `M${C[0] - rx},${C[1]} a${rx},${ry} 0 1 ${sens} ${2 * rx},0 a${rx},${ry} 0 1 ${sens} ${-2 * rx},0 Z`; };
// Anneaux (rayons en rayons de Saturne) : C 1,24–1,53 ; B 1,53–1,95 ; division de Cassini ; A 2,03–2,27 avec la division d’Encke.
const bandes: [number, number, number][] = [[1.24, 1.53, 0.35], [1.53, 1.95, 0.9], [2.03, 2.205, 0.7], [2.215, 2.27, 0.7]];
const anneaux = bandes.map(([a, b, o]) => `<path d="${ell(b)} ${ell(a, 1)}" fill="var(--brass)" fill-opacity="${o}" fill-rule="evenodd"/>`).join('');
let s = `<defs><clipPath id="${id}"><rect x="0" y="${C[1]}" width="600" height="400"/></clipPath></defs>`;
s += `<g transform="rotate(${incl} ${C[0]} ${C[1]})">${anneaux}`;
s += `<ellipse cx="${C[0]}" cy="${C[1]}" rx="${R}" ry="${R * 0.9}" fill="var(--sun)" fill-opacity=".75" stroke="var(--ink)" stroke-width="1"/>`;
for (const y of [-0.45, -0.15, 0.2, 0.5]) s += `<ellipse cx="${C[0]}" cy="${C[1] + y * R * 0.9}" rx="${R * Math.sqrt(1 - y * y)}" ry="${R * 0.08}" fill="none" stroke="var(--brass)" stroke-width="1" opacity=".5"/>`;
s += `<g clip-path="url(#${id})">${anneaux}</g></g>`;
const rot = (p: P2): P2 => { const a = (incl * Math.PI) / 180, dx = p[0] - C[0], dy = p[1] - C[1]; return [C[0] + dx * Math.cos(a) - dy * Math.sin(a), C[1] + dx * Math.sin(a) + dy * Math.cos(a)]; };
const etiq: [string, P2, P2][] = [
  ['anneau A', rot([C[0] + 2.12 * R, C[1]]), [520, 120]], ['division de Cassini', rot([C[0] + 1.99 * R, C[1]]), [470, 70]],
  ['anneau B', rot([C[0] - 1.75 * R, C[1]]), [40, 280]], ['division d’Encke', rot([C[0] - 2.21 * R, C[1]]), [30, 225]],
];
for (const [n, p, q] of etiq) s += trait2D(q, p, { couleur: 'var(--ink-soft)', epaisseur: 0.8 }) + texte2D(q, n, { dy: -4, ancre: q[0] > 300 ? 'start' : 'start', taille: 13.5 });
---
<Figure titre="Saturne et ses anneaux principaux, séparés par des divisions (dessin stylisé)" largeur={600} hauteur={360} svg={s}><slot /></Figure>
