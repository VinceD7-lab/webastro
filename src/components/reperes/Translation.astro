---
/** Translation de repère : point A lié (variante 1) ou non lié (variante 2) au repère (redessiné d’après ASM, P. Rocher). */
import Figure from './Figure.astro';
import { trait2D, texte2D, point2D, ind, type P2 } from '../../lib/projection';
interface Props { variante?: 1 | 2 }
const { variante = 1 } = Astro.props;
const E = 40;
function repere(O: P2, nom: string, lx: number, ly: number) {
  let s = trait2D(O, [O[0] + lx, O[1]], { fleche: 'fin', epaisseur: 1.2 }) + trait2D(O, [O[0], O[1] - ly], { fleche: 'fin', epaisseur: 1.2 });
  s += texte2D([O[0] + lx, O[1]], 'x', { dx: 2, dy: 18 }) + texte2D([O[0], O[1] - ly], 'y', { dx: -16, dy: 4 });
  s += trait2D(O, [O[0] + E, O[1]], { couleur: 'var(--ko)', epaisseur: 2.6, fleche: 'fin' }) + trait2D(O, [O[0], O[1] - E], { couleur: 'var(--ko)', epaisseur: 2.6, fleche: 'fin' });
  s += texte2D(O, `e${ind('1')}`, { dx: 16, dy: 22, italique: true, gras: true, couleur: 'var(--ko)', brut: true });
  s += texte2D(O, `e${ind('2')}`, { dx: -26, dy: -16, italique: true, gras: true, couleur: 'var(--ko)', brut: true });
  return s + point2D(O, 3.4) + texte2D(O, nom, { dx: -12, dy: 24, italique: true, taille: 17 });
}
function projections(O: P2, A: P2, prime: string) {
  const AX: P2 = [A[0], O[1]], AY: P2 = [O[0], A[1]];
  return trait2D(A, AX, { tirets: '5 4', epaisseur: 1 }) + trait2D(A, AY, { tirets: '5 4', epaisseur: 1 }) + point2D(AX, 3) + point2D(AY, 3)
    + texte2D(AX, `A${prime}${ind('X')}`, { dx: 4, dy: -8, italique: true, brut: true }) + texte2D(AY, `A${prime}${ind('Y')}`, { dx: -6, dy: -6, ancre: 'end', italique: true, brut: true })
    + texte2D([(O[0] + A[0]) / 2, O[1]], `u${prime}¹`, { dy: 20, italique: true }) + texte2D([O[0], (O[1] + A[1]) / 2], `u${prime}²`, { dx: -8, ancre: 'end', italique: true });
}
const Op: P2 = [70, 290], O: P2 = [250, 175];
let s = '';
if (variante === 1) {
  const d: P2 = [100, -105];
  s += repere(Op, 'O′', 165, 170) + repere(O, 'O', 160, 150);
  s += projections(Op, [Op[0] + d[0], Op[1] + d[1]], '') + projections(O, [O[0] + d[0], O[1] + d[1]], '');
  s += point2D([Op[0] + d[0], Op[1] + d[1]], 3.6) + texte2D([Op[0] + d[0], Op[1] + d[1]], 'A', { dx: 6, dy: -8, italique: true, taille: 17 });
  s += point2D([O[0] + d[0], O[1] + d[1]], 3.6) + texte2D([O[0] + d[0], O[1] + d[1]], 'A', { dx: 6, dy: -8, italique: true, taille: 17 });
  s += texte2D([30, 50], 'Le repère passe de O en O′ ;', { taille: 14 }) + texte2D([30, 70], 'le point A, lié au repère, le suit.', { taille: 14 });
} else {
  const A: P2 = [345, 95];
  s += repere(Op, 'O′', 330, 270) + repere(O, 'O', 160, 150);
  s += projections(O, A, '') + projections(Op, A, '′');
  s += point2D(A, 3.6) + texte2D(A, 'A', { dx: 6, dy: -8, italique: true, taille: 17 });
  s += texte2D([150, 322], 'Le repère passe de O en O′ ;', { taille: 14 }) + texte2D([150, 340], 'le point A, non lié au repère, ne bouge pas.', { taille: 14 });
}
s += trait2D(O, Op, { tirets: '10 4 2 4', epaisseur: 1, couleur: 'var(--ink-soft)' });
---
<Figure titre={variante === 1 ? 'Translation du repère de O en O′ : le point A, lié au repère, garde les mêmes coordonnées' : 'Translation du repère de O en O′ : le point A, non lié au repère, change de coordonnées'} largeur={440} hauteur={variante === 1 ? 320 : 352} svg={s}><slot /></Figure>
