---
import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import { url } from '../lib/url';
import { coursParDossier } from '../data/collection';
import { espacesFines } from '../lib/typo.mjs';
import MenuCours from '../components/MenuCours.astro';

interface Props {
  title: string; description?: string; actif?: 'glossaire';
  /** Cours de la page (dossier d’origine, ex. `pages_mctc`) : fil d’Ariane et repères du menu « Cours ». */
  cours?: string;
  /** Slug du chapitre affiché, pour le repère « page actuelle » du menu. */
  chapitre?: string;
  /** `article` pour les chapitres, `website` sinon (Open Graph). */
  type?: 'website' | 'article';
  /** Données structurées schema.org, sérialisées en JSON-LD. */
  jsonld?: Record<string, unknown>;
}
const { title, actif, cours: dossier, chapitre, type = 'website', jsonld } = Astro.props;
const coursActuel = dossier ? coursParDossier.get(dossier) : undefined;
if (dossier && !coursActuel) throw new Error(`BaseLayout : cours inconnu « ${dossier} »`);
const NOM_SITE = 'Lumières sur l’Univers';
const description = Astro.props.description ?? (coursActuel
  ? 'Cours de mécanique céleste, de mesure du temps et de calendriers, d’après Jean-Eudes Arlot (Observatoire de Paris).'
  : 'Les 22 cours de la collection « Lumières sur l’Univers » de l’Observatoire de Paris, avec le cours Mécanique céleste, Temps et Calendriers en version modernisée.');
const suffixe = coursActuel ? coursActuel.titre : NOM_SITE;
const titreComplet = title === 'Accueil' ? NOM_SITE : `${title} – ${suffixe}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const image = Astro.site ? new URL(url('/og.png'), Astro.site).href : undefined;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titreComplet}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <meta property="og:site_name" content={NOM_SITE} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={titreComplet} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  {canonical && <meta property="og:url" content={canonical} />}
  {image && <meta property="og:image" content={image} />}
  {image && <meta property="og:image:width" content="1200" />}
  {image && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#EEF1F7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1530" media="(prefers-color-scheme: dark)" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <!-- Appliqué avant l’affichage pour éviter un flash de mauvais thème -->
  <script is:inline>
    try { const t = localStorage.getItem('mctc-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="topbar">
    <div class="topbar-inner">
      <!-- Ouvre le menu latéral gauche des cours (src/components/MenuCours.astro) -->
      <button class="tool bouton-cours" id="openCours" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="coursDlg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h10M4 18h16"/></svg>
        <span class="lbl">Cours</span> <kbd>c</kbd>
      </button>
      <nav class="fil" aria-label="Fil d’Ariane">
        <a class="fil-site" href={url('/')} aria-current={!coursActuel && title === 'Accueil' ? 'page' : undefined}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--orbit)" stroke-width="1.6" aria-hidden="true"><ellipse cx="12" cy="12" rx="10" ry="5.2" transform="rotate(-24 12 12)"/><circle cx="12" cy="12" r="2.6" fill="var(--sun)" stroke="none"/></svg>
          <span class="fil-nom">{NOM_SITE}</span>
        </a>
        {coursActuel && (
          <>
            <span class="fil-sep" aria-hidden="true">/</span>
            <a class="fil-cours" href={coursActuel.local ? url(coursActuel.local) : coursActuel.entree}>{espacesFines(coursActuel.titre)}</a>
          </>
        )}
      </nav>
      <button class="tool menu-mobile" id="menuToggle" type="button" aria-expanded="false" aria-controls="topnav">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span class="lbl">Menu</span>
      </button>
      <nav class="topnav" id="topnav" aria-label="Navigation principale">
        <a href={url('/glossaire/')} aria-current={actif === 'glossaire' ? 'page' : undefined}>Glossaire</a>
      </nav>
      <button class="tool" id="openSearch" type="button" aria-label="Rechercher dans le cours">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="lbl">Rechercher</span> <kbd>/</kbd>
      </button>
      <button class="tool" id="themeToggle" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <span class="lbl" id="themeLabel">Thème</span>
      </button>
    </div>
    <div class="progress" id="progress" aria-hidden="true"></div>
  </header>

  <main id="contenu" tabindex="-1"><slot /></main>

  <footer class="site-footer">
    <div class="wrap">
      <p>Les cours de la collection <a href="https://media4.obspm.fr/public/ressources_lu/index.html">Lumières sur l’Univers</a> sont publiés par l’Observatoire de Paris. {coursActuel?.local ? <>« {espacesFines(coursActuel.titre)} », de {coursActuel.auteurs}, est présenté ici en version modernisée, textes adaptés.</> : <>Un cours est repris ici, en version modernisée, dès qu’il est réécrit ; les autres s’ouvrent sur le site d’origine.</>}</p>
    </div>
  </footer>

  <div class="tip" id="tip" role="tooltip" hidden></div>

  <MenuCours cours={dossier} chapitre={chapitre} />

  <dialog class="search" id="searchDlg" aria-labelledby="search-title">
    <div class="head">
      <h2 id="search-title">Rechercher dans le cours</h2>
      <button class="tool" type="button" id="closeSearch">Fermer</button>
    </div>
    <div id="pagefind"></div>
    <p class="small" id="searchMsg" hidden>La recherche est disponible sur le site construit (<code>npm run build</code> puis <code>npm run preview</code>), pas en mode développement.</p>
  </dialog>

  <script>
    /* ---------- thème ---------- */
    const root = document.documentElement;
    const label = document.getElementById('themeLabel')!;
    const courant = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const majLabel = () => { label.textContent = courant() === 'dark' ? 'Mode clair' : 'Mode sombre'; };
    majLabel();
    document.getElementById('themeToggle')!.addEventListener('click', () => {
      const t = courant() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = t;
      try { localStorage.setItem('mctc-theme', t); } catch (e) {}
      majLabel();
    });

    /* ---------- menu mobile ---------- */
    const menuBtn = document.getElementById('menuToggle')!;
    const nav = document.getElementById('topnav')!;
    const basculerMenu = (ouvrir: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(ouvrir));
      nav.classList.toggle('ouvert', ouvrir);
    };
    menuBtn.addEventListener('click', (ev) => { ev.stopPropagation(); basculerMenu(menuBtn.getAttribute('aria-expanded') !== 'true'); });
    nav.addEventListener('click', (ev) => { if ((ev.target as HTMLElement).closest('a')) basculerMenu(false); });
    document.addEventListener('click', (ev) => { if (!nav.contains(ev.target as Node)) basculerMenu(false); });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && nav.classList.contains('ouvert')) { basculerMenu(false); menuBtn.focus(); }
    });

    /* ---------- impression : indices, corrections et approfondissements dépliés ---------- */
    let fermesAvantImpression: HTMLDetailsElement[] = [];
    addEventListener('beforeprint', () => {
      fermesAvantImpression = [...document.querySelectorAll<HTMLDetailsElement>('main details:not([open])')];
      fermesAvantImpression.forEach((d) => { d.open = true; });
    });
    addEventListener('afterprint', () => {
      fermesAvantImpression.forEach((d) => { d.open = false; });
      fermesAvantImpression = [];
    });

    /* ---------- infobulles du glossaire ---------- */
    const tip = document.getElementById('tip')!;
    let ouvert: HTMLElement | null = null;
    function montrer(el: HTMLElement) {
      tip.innerHTML = '';
      const s = document.createElement('strong'); s.textContent = el.dataset.titre || '';
      tip.append(s, document.createTextNode(el.dataset.def || ''));
      tip.hidden = false; ouvert = el; el.setAttribute('aria-describedby', 'tip');
      const r = el.getBoundingClientRect(), w = tip.offsetWidth;
      tip.style.left = Math.max(8, Math.min(scrollX + r.left, scrollX + document.documentElement.clientWidth - w - 8)) + 'px';
      tip.style.top = (scrollY + r.bottom + 8) + 'px';
    }
    function cacher() { tip.hidden = true; ouvert?.removeAttribute('aria-describedby'); ouvert = null; }
    document.querySelectorAll<HTMLElement>('.term').forEach((el) => {
      el.addEventListener('click', (ev) => { ev.stopPropagation(); ouvert === el ? cacher() : montrer(el); });
      el.addEventListener('mouseenter', () => montrer(el));
      el.addEventListener('mouseleave', cacher);
      el.addEventListener('focus', () => montrer(el));
      el.addEventListener('blur', cacher);
    });
    document.addEventListener('click', cacher);
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') cacher(); });

    /* ---------- recherche Pagefind (chargée à la première ouverture) ---------- */
    const dlg = document.getElementById('searchDlg') as HTMLDialogElement;
    let charge = false;
    async function chargerPagefind() {
      if (charge) return; charge = true;
      const base = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'pagefind/';
      const css = document.createElement('link'); css.rel = 'stylesheet'; css.href = base + 'pagefind-ui.css';
      document.head.append(css);
      await new Promise<void>((ok) => {
        const s = document.createElement('script'); s.src = base + 'pagefind-ui.js';
        s.onload = () => ok(); s.onerror = () => { document.getElementById('searchMsg')!.hidden = false; ok(); };
        document.head.append(s);
      });
      const PF = (window as any).PagefindUI;
      if (PF) new PF({ element: '#pagefind', showSubResults: true, showImages: false, resetStyles: false,
        translations: { placeholder: 'Chercher une notion, un calendrier…', zero_results: 'Aucun résultat pour [SEARCH_TERM]' } });
    }
    async function ouvrir() {
      dlg.showModal();
      await chargerPagefind();
      dlg.querySelector<HTMLInputElement>('input')?.focus();
    }
    document.getElementById('openSearch')!.addEventListener('click', ouvrir);
    document.getElementById('closeSearch')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });
    dlg.addEventListener('click', (ev) => { if ((ev.target as HTMLElement).closest('a')) dlg.close(); });
    document.addEventListener('keydown', (ev) => {
      const tag = document.activeElement?.tagName || '';
      if (ev.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(tag) && !dlg.open) { ev.preventDefault(); ouvrir(); }
    });
  </script>
</body>
</html>
