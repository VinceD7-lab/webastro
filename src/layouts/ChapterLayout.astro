---
import { readFileSync } from 'node:fs';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { chapitres } from '../data/chapitres';
import { url } from '../lib/url';
import VoletPersonnes from '../components/VoletPersonnes.astro';

interface Props { entry: CollectionEntry<'cours'>; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const { title, numero, resume, auteur, source } = entry.data;
const sommaire = headings.filter((h) => h.depth === 2);
const lien = (c?: (typeof chapitres)[number]) => (c ? { href: c.slug ? url(`/cours/${c.slug}/`) : c.source, externe: !c.slug, titre: c.titre } : null);
const i = chapitres.findIndex((c) => c.numero === numero);
const prec = lien(chapitres[i - 1]);
const suiv = lien(chapitres[i + 1]);
// Volet des personnalités : seulement sur les chapitres qui utilisent le composant Personne.
// (`entry.body` n’est pas toujours fourni pour les fichiers MDX : on lit alors le fichier source.)
const texteSource = entry.body || (entry.filePath ? readFileSync(entry.filePath, 'utf8') : '');
const avecPersonnes = texteSource.includes('<Personne ');
---
<BaseLayout title={title} description={resume}>
  <section class="chapter" aria-labelledby="titre-chapitre">
    <div class="chapter-grid">
      <nav class="toc" aria-label="Sommaire du chapitre">
        <p class="crumb"><a href={url('/#plan')}>Cours</a> › Chapitre {numero}</p>
        <details class="toc-details" open>
          <summary>Sommaire du chapitre</summary>
          <ol>
            {sommaire.map((h) => <li><a class="lnk" href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </details>
      </nav>

      <article class="prose" data-pagefind-body>
        <header>
          <p class="kicker">Chapitre {numero} sur {chapitres.length} · {auteur}</p>
          <h1 id="titre-chapitre" data-pagefind-meta="title">{title}</h1>
        </header>
        <div class="content">
          <slot />
        </div>
        {source && <p class="small no-print" data-pagefind-ignore>Version d’origine : <a href={source}>site de l’Observatoire de Paris</a>.</p>}

        <nav class="pager" aria-label="Chapitres voisins" data-pagefind-ignore>
          {prec && <a href={prec.href}><small>Chapitre précédent</small>{prec.titre}</a>}
          {suiv && <a class="next" href={suiv.href}><small>Chapitre suivant</small>{suiv.titre}</a>}
        </nav>
      </article>
    </div>
  </section>
  {avecPersonnes && <VoletPersonnes />}
</BaseLayout>

<script>
  /* Section en cours dans le sommaire */
  const liens = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a.lnk'));
  const parId = new Map(liens.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const io = new IntersectionObserver((entrees) => {
    for (const e of entrees) {
      if (!e.isIntersecting) continue;
      const a = parId.get(e.target.id);
      if (!a) continue;
      liens.forEach((l) => { l.classList.remove('active'); l.removeAttribute('aria-current'); });
      a.classList.add('active'); a.setAttribute('aria-current', 'true');
    }
  }, { rootMargin: '-15% 0px -75% 0px' });
  parId.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });

  /* Barre de progression de lecture */
  const article = document.querySelector('article.prose')!;
  const barre = document.getElementById('progress')!;
  const maj = () => {
    const r = article.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight * 0.6)));
    barre.style.width = p * 100 + '%';
  };
  addEventListener('scroll', maj, { passive: true }); addEventListener('resize', maj); maj();

  /* Sommaire replié sur mobile */
  const det = document.querySelector<HTMLDetailsElement>('.toc-details')!;
  const mode = () => { det.open = innerWidth > 900; };
  mode(); addEventListener('resize', mode);
</script>
